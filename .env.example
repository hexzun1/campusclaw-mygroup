# 会话
SESSION_SECRET=change-me-to-a-random-secret
SESSION_TTL=24h

# 数据库（api 使用的普通账号，非 root）
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw_app
DB_PASSWORD=change-me-db-password

# 仅供 db 容器初始化使用，不下发给 api
MYSQL_ROOT_PASSWORD=change-me-root-password

# 上传
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152

# 登录限流
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# 预置账号口令
SEED_TEACHER_A_PASSWORD=change-me-teacher-a
SEED_STUDENT_A1_PASSWORD=change-me-student-a1
SEED_STUDENT_B1_PASSWORD=change-me-student-b1

# 端口
WEB_PORT=8080
API_PORT=8081
