# JWT 登录（JWT_SECRET 至少 32 个字符，否则 api 启动失败；JWT_TTL 可选，默认 24h）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_TTL=24h

# 数据库（api 使用的普通账号，非 root）
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw_app
DB_PASSWORD=change-me-db-password

# 仅供 db 容器初始化使用，不下发给 api
MYSQL_ROOT_PASSWORD=change-me-root-password

# 上传
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152

# MCP 工具服务器：api 与 mcp-demo 共用同一令牌。
# 留空时 mcp-demo 拒绝启动，api 也不会预置 campus-tools（api 本身照常启动）。
MCP_AUTH_TOKEN=

# 登录限流
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# 可信反向代理：只有来自这些地址的登录请求才读取 X-Real-IP，其余一律按
# RemoteAddr 计数。逗号分隔 IP 或 CIDR；留空表示不信任任何代理。
# 正式编排把 web 容器固定为 172.31.240.10（见 docker-compose.yml 的 edge 网络），
# 这里只写这一个地址——不要改成整个网段，否则同网段的任何容器都能伪造该头。
# 直连 api 的来源（开发编排、本机 curl）不应出现在列表内。
TRUSTED_PROXY_CIDRS=172.31.240.10/32

# 预置账号口令
SEED_TEACHER_A_PASSWORD=change-me-teacher-a
SEED_STUDENT_A1_PASSWORD=change-me-student-a1
SEED_STUDENT_B1_PASSWORD=change-me-student-b1

# 端口
WEB_PORT=8080
API_PORT=8081

# 向量检索（迭代 2）。以下 8 项缺失时 api 启动失败并打印变量名。
# QDRANT_URL 在 Compose 内用服务名；api 通过它访问向量库，浏览器不直连。
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# 嵌入网关（OpenAI 兼容协议，服务端专用）
EMBEDDING_BASE_URL=https://gateway.example.com/v1
EMBEDDING_API_KEY=change-me-embedding-api-key
EMBEDDING_MODEL=change-me-embedding-model
EMBEDDING_DIM=1024

# 对话网关（OpenAI 兼容协议，非流式，服务端专用）
CHAT_BASE_URL=https://gateway.example.com/v1
CHAT_API_KEY=change-me-chat-api-key
CHAT_MODEL=change-me-chat-model

# 可选：外部调用参数（默认值见括号）
EMBEDDING_BATCH_SIZE=32
GATEWAY_TIMEOUT_SECONDS=30
INDEX_TIMEOUT_SECONDS=120
