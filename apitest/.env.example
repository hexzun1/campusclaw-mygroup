# 复制为 apitest/.env 后填写真实值；本文件只列变量名，不得写入任何真实值。
# 开发编排（docker-compose.dev.yml）下 API_BASE_URL 通常是 http://localhost:8081。
API_BASE_URL=
# 可选的第二个入口地址：只有登录限流跨源地址的用例需要，未填写时这些用例跳过。
# 两个地址必须让 api 看到不同的真实源 IP（例如 127.0.0.1 与宿主机 LAN 地址）。
API_BASE_URL_ALT=
# 可选的网关桩地址，默认 http://127.0.0.1:8091。
STUB_BASE_URL=
# 可选的 MCP 示例服务器地址，默认 http://mcp-demo:8090；在编排网络外运行时填写。
MCP_SERVER_BASE_URL=
APITEST_DB_HOST=
APITEST_DB_PORT=
APITEST_DB_USER=
APITEST_DB_PASSWORD=
APITEST_DB_NAME=
MCP_AUTH_TOKEN=
APITEST_TEACHER_A_PASSWORD=
APITEST_STUDENT_A1_PASSWORD=
APITEST_STUDENT_B1_PASSWORD=
